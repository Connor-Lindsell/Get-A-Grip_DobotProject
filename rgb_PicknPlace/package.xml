<?xml version="1.0"?>
<package format="2">
  <name>rgb_PicknPlace</name>
  <version>0.0.1</version>
  <description>
    Example ROS1 package that implements a colour-driven pick-and-place
    routine for the Dobot Magician using the dobot_magician_driver topics.
  </description>

  <maintainer email="team@example.com">Get-A-Grip Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>roscpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>message_filters</depend>
  <depend>std_srvs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>opencv4</depend>

  <export>
  </export>
</package>